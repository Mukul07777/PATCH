# LLM provider (OpenAI-compatible). Nebius Token Factory is the default; pick ONE option below.
# The variable names say NEBIUS_ but any OpenAI-compatible endpoint works.

# Option 1 (default): Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Nebius Nemotron ids, verified with GET /v1/models on 2026-10-29 and used for the recorded benchmark in demo-runs/.
# Auto-discovery also maps "Lightning"/"mini" ids to the nano tier, but pinning is safer:
# MODEL_NANO=nvidia/Nemotron-3_5-Lightning
# MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Option 2: NVIDIA NIM
# NEBIUS_API_KEY=nvapi-xxxxxxxx
# NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1

# Option 3 (fallback): OpenRouter (free tier; pin the models below)
# NEBIUS_API_KEY=sk-or-xxxxxxxx
# NEBIUS_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NANO=nvidia/nemotron-3.5-lightning:free
# MODEL_SUPER=nvidia/nemotron-3.5-super-vl:free
# MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b:free

# Leave blank to auto-discover Nemotron models from /models
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=
# Optional: USD per 1M tokens as "input/output" (e.g. 0.06/0.24), for cost reporting
PRICE_NANO=
PRICE_SUPER=
PRICE_ULTRA=

# Tavily web search (optional; the research step is skipped if blank)
TAVILY_API_KEY=

# Optional: open real pull requests on GitHub; also raises the org-scan rate limit
GITHUB_TOKEN=

MAX_FIX_ATTEMPTS=4
# Set to 1 only on trusted/local deployments: remote repos run arbitrary test code on the server
ALLOW_REMOTE_REPOS=0

# Content-safety gate for AI-written code (1 = on). MODEL_GUARD is only auto-filled on OpenRouter
# (nvidia/nemotron-3.5-content-safety:free). On Nebius Token Factory set it to the content-safety model id
# that GET /v1/models lists for your account (e.g. nvidia/nemotron-3.5-content-safety on NIM);
# leave blank for the static AST screen only.
GUARD=1
MODEL_GUARD=
