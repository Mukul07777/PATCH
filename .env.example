# LLM provider (OpenAI-compatible). Nebius Token Factory is the default; pick ONE option below.
# The variable names say NEBIUS_ but any OpenAI-compatible endpoint works.

# Option 1 (default): Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Nemotron routing on Token Factory (ids verified with GET /v1/models on 2026-10-29, used for demo-runs/):
#   Nano  = fast, high-volume calls (triage, reachability symbols, rerank)
#   Super = everyday work (upgrade plan, exploit proof, first repair attempt)
#   Ultra = serious reasoning, only after Super's fix fails tests
MODEL_NANO=nvidia/Nemotron-3_5-Lightning
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Option 2: NVIDIA NIM
# NEBIUS_API_KEY=nvapi-xxxxxxxx
# NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1

# Option 3 (fallback): OpenRouter (free tier; pin the models below)
# NEBIUS_API_KEY=sk-or-xxxxxxxx
# NEBIUS_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NANO=nvidia/nemotron-3.5-lightning:free
# MODEL_SUPER=nvidia/nemotron-3.5-super-vl:free
# MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b:free

# (With option 2 or 3, replace the three MODEL_* values above, or blank them to auto-discover Nemotron
# models from the provider's /models list.)
# Optional: USD per 1M tokens as "input/output" (e.g. 0.06/0.24), for cost reporting
PRICE_NANO=
PRICE_SUPER=
PRICE_ULTRA=

# Tavily web search (optional; the research step is skipped if blank)
TAVILY_API_KEY=

# Optional: open real pull requests on GitHub; also raises the org-scan rate limit
GITHUB_TOKEN=

MAX_FIX_ATTEMPTS=4
# Set to 1 only on trusted/local deployments: fix mode runs a remote repo's test code on the server.
# Scan-only mode (Projects page) never runs repo code, so it can read remote manifests either way.
ALLOW_REMOTE_REPOS=0
# Set to 1 to allow projects that point at a directory on the server (self-hosted only)
ALLOW_LOCAL_PATHS=0
# SQLite database for projects, scans and findings (default runs/patchpilot.db)
PATCHPILOT_DB=
# Encrypts secrets saved on the Settings page (a Fernet key or any passphrase). If empty, a random key is
# generated into runs/secret.key on first use. Set it in production.
PATCHPILOT_SECRET_KEY=
# 1 = anonymous visitors may read sample projects and the shipped demo-runs replays (read-only); everything
# else needs a sign-in. The first visit to a new install creates the admin account on /setup.
PATCHPILOT_PUBLIC_DEMO=0
# Legacy: an admin bearer token for scripts (Authorization: Bearer <token>). Prefer API keys from /settings.
PATCHPILOT_TOKEN=

# Content-safety gate for AI-written code (1 = on). MODEL_GUARD is only auto-filled on OpenRouter
# (nvidia/nemotron-3.5-content-safety:free). On Nebius Token Factory set it to the content-safety model id
# that GET /v1/models lists for your account (e.g. nvidia/nemotron-3.5-content-safety on NIM);
# leave blank for the static AST screen only.
GUARD=1
MODEL_GUARD=
